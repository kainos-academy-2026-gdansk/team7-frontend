{% import "partials/formMacros.njk" as form %}

{% macro createJobRoleForm(action, values, errors, errorList, bands, capabilities, submitLabel) %}
  {{ form.errorSummary(errorList) }}

  <form class="kainos-form" method="post" action="{{ action }}" novalidate>
    {{ form.textInput("roleName", "Role name", values.roleName, errors.roleName) }}
    {{ form.textInput("location", "Location", values.location, errors.location) }}
    {{ form.select(
      "bandId", "Band", values.bandId, bands,
      error = errors.bandId, placeholder = "Choose a band", valueKey = "id", labelKey = "name"
    ) }}
    {{ form.select(
      "capabilityId", "Capability", values.capabilityId, capabilities,
      error = errors.capabilityId, placeholder = "Choose a capability", valueKey = "id", labelKey = "name"
    ) }}
    {{ optionalFields(values, errors) }}

    <button class="kainos-button kainos-form__submit" type="submit">{{ submitLabel }}</button>
  </form>
{% endmacro %}

{% macro editJobRoleForm(action, values, errors, errorList, bands, capabilities, submitLabel) %}
  {{ form.errorSummary(errorList) }}

  <form class="kainos-form" method="post" action="{{ action }}" novalidate>
    {{ form.textInput("jobRoleName", "Role name", values.jobRoleName, errors.jobRoleName) }}
    {{ form.textInput("location", "Location", values.location, errors.location) }}
    {{ form.select(
      "bandName", "Band", values.bandName, bands,
      error = errors.bandName, placeholder = "Choose a band", valueKey = "name", labelKey = "name"
    ) }}
    {{ form.select(
      "capabilityName", "Capability", values.capabilityName, capabilities,
      error = errors.capabilityName, placeholder = "Choose a capability", valueKey = "name", labelKey = "name"
    ) }}
    {{ form.select(
      "status", "Status", values.status,
      [{ value: "OPEN", label: "Open" }, { value: "CLOSED", label: "Closed" }],
      error = errors.status
    ) }}
    {{ optionalFields(values, errors) }}

    <button class="kainos-button kainos-form__submit" type="submit">{{ submitLabel }}</button>
  </form>
{% endmacro %}

{% macro optionalFields(values, errors) %}
  {{ form.textarea("description", "Description", values.description, errors.description,
    "Optional. Up to 2000 characters.") }}
  {{ form.textarea("responsibilities", "Responsibilities", values.responsibilities, errors.responsibilities,
    "Optional. Up to 2000 characters.") }}
  {{ form.textInput("openPositions", "Open positions", values.openPositions, errors.openPositions,
    "number", "Optional. Leave blank if the number is not known yet.") }}
  {{ form.textInput("sharePointLink", "SharePoint link", values.sharePointLink, errors.sharePointLink,
    "url", "Optional. The full URL of the job specification.") }}
  {{ form.textInput("closingDate", "Closing date", values.closingDate, errors.closingDate,
    "date", "Optional. Leave blank if the role has no closing date.") }}
{% endmacro %}
