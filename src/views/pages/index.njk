
{% extends "layouts/base.njk" %}

{% block title %}Home{% endblock %}

{% block content %}
  <section class="kainos-hero">
    <div class="kainos-hero__panels">
      <div class="kainos-hero__content">
        <h1 class="govuk-heading-xl kainos-hero__title">Find your next role at Kainos</h1>
        <p class="kainos-hero__lead">
          We build digital services that make a difference. Browse the roles we are
          currently hiring for and find where you fit in.
        </p>
        <a class="kainos-button" href="/job-roles">View job roles</a>
      </div>
      <div class="kainos-home-panels">
        <article class="kainos-home-panel">
          <h2 class="govuk-heading-m kainos-home-panel__title">Digital services</h2>
          <p class="govuk-body kainos-home-panel__text">
            We create technology that helps people, organisations and communities thrive.
          </p>
          <a
            class="govuk-link kainos-home-panel__link"
            href="https://www.kainos.com/digital-services"
          >
            Discover Digital Services
          </a>
        </article>
        <article class="kainos-home-panel">
          <h2 class="govuk-heading-m kainos-home-panel__title">About us</h2>
          <p class="govuk-body kainos-home-panel__text">
            Discover who we are, what we value and how we make a difference through technology.
          </p>
          <a
            class="govuk-link kainos-home-panel__link"
            href="https://www.kainos.com/about-us"
          >
            Learn more about Kainos
          </a>
        </article>
      </div>
    </div>
    <div class="kainos-hero__image">
      <img
        src="/images/hero-illustration.png"
        alt="A job seeker aiming for their next role at Kainos"
        width="1000"
        height="872"
      />
    </div>
  </section>
{% endblock %}
