{% extends "layouts/base.njk" %}

{% block title %}Job roles{% endblock %}

{% block banner %}
  <div class="kainos-page-banner">
    <div class="govuk-width-container">
      <h1 class="govuk-heading-l kainos-page-banner__title">Job roles</h1>
    </div>
  </div>
{% endblock %}

{% macro fact(label, value, icon) %}
  <span class="kainos-job__fact">
    <img class="kainos-job__icon" src="/images/icons/{{ icon }}.png" alt="" width="289" height="289" />
    <span class="govuk-visually-hidden">{{ label }}:</span>{{ value }}
  </span>
{% endmacro %}

{% block content %}
  {% if totalCount > 0 %}
    <div class="kainos-job-list">
      <p class="kainos-job-list__count">{{ totalCount }} jobs found</p>
      <ul class="kainos-job-list__items">
        {% for jobRole in jobRoles %}
          <li class="kainos-job">
            <h2 class="kainos-job__title">{{ jobRole.roleName }}</h2>
            <p class="kainos-job__facts">
              {{ fact("Location", jobRole.location, "location") }}
              {{ fact("Capability", jobRole.capability, "capability") }}
              {{ fact("Band", jobRole.band, "band") }}
            </p>
            <div style="display: flex; flex-direction: column;">
              <p class="kainos-job__facts kainos-job__closing">
                {{ fact("Closing date", jobRole.closingDate | formatDate, "closing-date") }}
              </p>
              {% if jobRole.id %}
                <a href="/job-roles/{{ jobRole.id }}" class="govuk-button govuk-!-margin-top-3 govuk-!-margin-bottom-0" role="button" draggable="false" data-module="govuk-button" aria-label="View offer for {{ jobRole.roleName }}">View offer</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>

    {# Pagination parked until the team agrees on a page size.
    {% if totalPages > 1 %}
      <nav class="kainos-pagination" aria-label="Job roles pagination">
        {% if page > 1 %}
          <a class="kainos-pagination__step" rel="prev" href="/job-roles?page={{ page - 1 }}">Previous</a>
        {% endif %}
        <ul class="kainos-pagination__pages">
          {% for number in range(1, totalPages + 1) %}
            <li>
              {% if number == page %}
                <a class="kainos-pagination__page kainos-pagination__page--current"
                   aria-current="page" href="/job-roles?page={{ number }}">{{ number }}</a>
              {% else %}
                <a class="kainos-pagination__page" href="/job-roles?page={{ number }}">
                  <span class="govuk-visually-hidden">Page </span>{{ number }}
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
        {% if page < totalPages %}
          <a class="kainos-pagination__step" rel="next" href="/job-roles?page={{ page + 1 }}">Next</a>
        {% endif %}
      </nav>
    {% endif %}
    #}
  {% else %}
    <p class="govuk-body">There are no job roles available at the moment.</p>
  {% endif %}
{% endblock %}
